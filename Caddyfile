{
	on_demand_tls {
		ask http://app:3000/api/internal/caddy-ask
	}
}

import /rc/caddy/*.caddy

:80 {
	encode gzip zstd
	@reddrop host {$RC_REDDROP_DOMAIN:reddrop.invalid}
	handle @reddrop {
		redir https://{host}{uri} 308
	}
	handle {
		request_body {
			max_size 110MB
		}
		reverse_proxy app:3000
	}
}

https:// {
	tls {
		on_demand
	}
	encode gzip zstd
	@reddrop host {$RC_REDDROP_DOMAIN:reddrop.invalid}
	handle @reddrop {
		header Strict-Transport-Security "max-age=31536000; includeSubDomains"
		request_body {
			max_size 10GB
		}
		reverse_proxy reddrop:3000
	}
	handle {
		request_body {
			max_size 110MB
		}
		reverse_proxy app:3000
	}
}
