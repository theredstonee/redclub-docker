# Eigenes, langes Passwort fuer die Datenbank (nur intern im Docker-Netz verwendet).
DB_PASSWORD=

# Zeitzone des Servers
TZ=Europe/Berlin

# Sprache bis zur Einrichtung (de|en)
RC_LANG=de

# Wie RedClub nach aussen kommt (install.sh setzt das automatisch):
#   eigener Caddy auf Port 80/443 mit automatischem HTTPS:
COMPOSE_FILE=docker-compose.yml:compose.caddy.yml
#   ODER nur ein Port hinter deinem vorhandenen nginx/Apache:
#COMPOSE_FILE=docker-compose.yml:compose.port.yml
#RC_PORT=8080
#RC_BIND=127.0.0.1
#RC_PROXY_DOMAIN=verein.example.com

# Cloudflare Tunnel — setzt das Panel (Einstellungen → Installation) automatisch, nicht von Hand nötig.
# RC_TUNNEL_TOKEN=

# RedDrop (Dateien & Fotos) im selben Compose — install.sh fragt danach:
#COMPOSE_FILE=docker-compose.yml:compose.caddy.yml:compose.reddrop.yml
#RC_REDDROP_DOMAIN=dateien.verein.example.com
#REDDROP_DB_PASSWORD=
